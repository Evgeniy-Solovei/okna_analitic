{
	# HTTP/3 (QUIC) на этом хосте ломает загрузку: Django отдаёт HTML за ~50мс,
	# а браузер висит 10+ секунд / «ожидает». В логах Caddy уже был UDP buffer warning.
	servers {
		protocols h1 h2
	}
}

{$APP_DOMAIN:platform.oknapanorama.by} {
	encode gzip

	@scanners {
		path /.git/*
		path /.env*
		path /.aws/*
		path /.ssh/*
		path /.npmrc
		path /.htpasswd
		path /.git-credentials
		path /.gitlab-ci.yml
		path /.github/*
		path /Dockerfile*
		path /docker-compose*
		path /firebase*
		path /secrets*
		path /credentials*
		path /terraform*
		path /serverless*
		path /service-account*
		path /serviceAccount*
		path /key.json
		path /cgi-bin*
		path /_profiler*
		path /actuator*
		path /feast*
		path /langflow*
		path /v1/graphql
		path /api/v1/validate*
		path /api/v1/configs*
		path /api/v1/build*
		path /api/auth*
		path /api/providers*
		path /api/datasources*
		path /api/usage*
		path /exec-py
		path /model/info
		path /_security*
	}
	abort @scanners

	redir /admin /admin/ 308

	reverse_proxy django:8000
}
